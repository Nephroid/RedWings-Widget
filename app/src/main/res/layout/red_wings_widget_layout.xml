<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_heritage"
    android:orientation="vertical"
    android:gravity="fill"
    android:clipToPadding="true"
    android:clipChildren="true"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Header: title + tag left, theme toggle right (RemoteViews-safe only) -->
    <LinearLayout
        android:id="@+id/widget_header_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="2dp"
        android:paddingRight="2dp">

        <TextView
            android:fontFamily="serif"
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RED WINGS"
            android:textColor="#1A1210"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:includeFontPadding="false"
            android:layout_marginEnd="6dp" />

        <TextView
            android:fontFamily="serif"
            android:id="@+id/widget_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_tag_heritage"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="NEXT GAME"
            android:textColor="#F5F1E6"
            android:textSize="8sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/widget_theme_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_tag_heritage"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="&#127912; THEME"
            android:textColor="#F5F1E6"
            android:textSize="8sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Divider as FrameLayout (NO bare <View>: not RemoteViews-safe) -->
    <FrameLayout
        android:id="@+id/widget_divider_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CE1126"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp" />

    <!-- Matchup: away logo | opponent + countdown | home logo -->
    <LinearLayout
        android:id="@+id/widget_matchup_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5.0"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <ImageView
            android:id="@+id/widget_away_logo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:scaleType="fitCenter"
            android:padding="2dp"
            android:src="@drawable/ic_redwings_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.2"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
            android:fontFamily="serif"
                android:id="@+id/widget_opponent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="vs. Maple Leafs"
                android:textColor="#1A1210"
                android:textSize="12sp"
                android:textStyle="bold|italic"
                android:letterSpacing="0.02"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1d 02h 45m"
                android:textColor="#CE1126"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_home_logo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:scaleType="fitCenter"
            android:padding="2dp"
            android:src="@drawable/ic_puck_placeholder" />
    </LinearLayout>

    <!-- Venue + standings context card -->
    <LinearLayout
        android:id="@+id/widget_info_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.0"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:fontFamily="serif"
            android:id="@+id/widget_venue_info"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Little Caesars Arena &#8226; Home"
            android:textColor="#1A1210"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:gravity="center|center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <TextView
            android:fontFamily="serif"
            android:id="@+id/widget_standing_h2h"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="3rd in Atlantic &#8226; 25-20-5 &#8226; 4 pts out"
            android:textColor="#1A1210"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:gravity="center|center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Atlantic standings: 2 columns x 4 rows (All 8 Teams) -->
    <LinearLayout
        android:id="@+id/widget_standings_table"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.2"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <!-- Column 1 (Ranks 1, 3, 5, 7) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="1. BOS: 51-20-11"
                android:textColor="#5A4A33"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="3. FLA: 45-27-10"
                android:textColor="#5A4A33"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_5"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="5. TBL: 40-32-10"
                android:textColor="#5A4A33"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_7"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="7. OTT: 34-39-9"
                android:textColor="#5A4A33"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Column 2 (Ranks 2, 4, 6, 8) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="2. TOR: 46-26-10"
                android:textColor="#5A4A33"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="4. DET: 42-30-10"
                android:textColor="#CE1126"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_6"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="6. MTL: 37-36-9"
                android:textColor="#5A4A33"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_8"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="8. BUF: 30-43-9"
                android:textColor="#5A4A33"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center|center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
