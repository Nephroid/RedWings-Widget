<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_heritage"
    android:orientation="vertical"
    android:gravity="fill"
    android:clipToPadding="true"
    android:clipChildren="true"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Header: title + tag left, theme toggle right -->
    <LinearLayout
        android:id="@+id/widget_header_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="2dp"
        android:paddingRight="2dp">

        <TextView
            android:fontFamily="serif"
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RED WINGS"
            android:textColor="#1A1210"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:includeFontPadding="false"
            android:layout_marginEnd="6dp" />

        <TextView
            android:fontFamily="serif"
            android:id="@+id/widget_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_tag_heritage"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="NEXT GAME"
            android:textColor="#F7F3EA"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/widget_theme_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_tag_heritage"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="&#127912; THEME"
            android:textColor="#F7F3EA"
            android:textSize="8.5sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Top Red Divider Line -->
    <FrameLayout
        android:id="@+id/widget_divider_top"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#CE1126"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp" />

    <!-- Matchup: away team (left) | game time + @ + countdown (center) | home team (right) -->
    <LinearLayout
        android:id="@+id/widget_matchup_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.4"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <!-- Away Team (Left) -->
        <LinearLayout
            android:id="@+id/widget_away_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_away_logo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:src="@drawable/ic_puck_vector" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_away_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOR"
                android:textColor="#1A1210"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Center: Game Date/Time + @ + Countdown -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.4"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_opponent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAT • 7:00 PM"
                android:textColor="#1A1210"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_matchup_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@"
                android:textColor="#CE1126"
                android:textSize="11sp"
                android:textStyle="bold|italic"
                android:gravity="center"
                android:includeFontPadding="false" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1d 02h 45m"
                android:textColor="#CE1126"
                android:textSize="23sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Home Team (Right) -->
        <LinearLayout
            android:id="@+id/widget_home_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_home_logo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:src="@drawable/ic_redwings_logo" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_home_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DET"
                android:textColor="#1A1210"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Venue + standings context pill card matching mockup -->
    <LinearLayout
        android:id="@+id/widget_info_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/widget_info_pill"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:fontFamily="serif"
            android:id="@+id/widget_standing_h2h"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Little Caesars Arena &#8226; Home &#8226; 3rd ATL &#8226; 4 pts out"
            android:textColor="#1A1210"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Kept GONE for test ID preservation -->
        <TextView
            android:id="@+id/widget_venue_info"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Atlantic standings: 2 columns x 4 rows with grid borders matching mockup -->
    <LinearLayout
        android:id="@+id/widget_standings_table"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4.8"
        android:background="@drawable/widget_standings_bg"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- Column 1 (Ranks 1, 2, 3, 4) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="1. BOS: 51-20-11"
                android:textColor="#1A1210"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDD6C7" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="2. FLA: 45-27-10"
                android:textColor="#1A1210"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDD6C7" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="3. TOR: 46-26-10"
                android:textColor="#1A1210"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDD6C7" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="4. DET: 42-30-10"
                android:textColor="#CE1126"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Vertical dividing line between Column 1 and Column 2 -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#DDD6C7" />

        <!-- Column 2 (Ranks 5, 6, 7, 8) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_5"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="5. TBL: 40-32-10"
                android:textColor="#1A1210"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDD6C7" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_6"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="6. OTT: 34-39-9"
                android:textColor="#1A1210"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDD6C7" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_7"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="7. BUF: 37-37-5"
                android:textColor="#1A1210"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDD6C7" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_team_8"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="8. MTL: 29-36-12"
                android:textColor="#1A1210"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
