<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_heritage"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clipToPadding="true"
    android:clipChildren="true"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- LEFT PANE: Matchup & Countdown Hub (48% width) -->
    <LinearLayout
        android:id="@+id/widget_left_pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="6dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/widget_header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RED WINGS"
                android:textColor="#1A1210"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:includeFontPadding="false"
                android:layout_marginEnd="6dp" />

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_tag_heritage"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="NEXT GAME"
                android:textColor="#F7F3EA"
                android:textSize="8sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Button
                android:id="@+id/widget_theme_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_tag_heritage"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="&#127912; THEME"
                android:textColor="#F7F3EA"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_divider_top"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="#CE1126"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp" />

        <!-- Matchup row -->
        <LinearLayout
            android:id="@+id/widget_matchup_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_away_logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:src="@drawable/ic_puck_vector" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:fontFamily="serif"
                    android:id="@+id/widget_opponent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="vs. Maple Leafs"
                    android:textColor="#1A1210"
                    android:textSize="11sp"
                    android:textStyle="bold|italic"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:fontFamily="serif"
                    android:id="@+id/widget_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1d 02h 45m"
                    android:textColor="#CE1126"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_home_logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:src="@drawable/ic_redwings_logo" />
        </LinearLayout>

        <!-- Venue Pill -->
        <LinearLayout
            android:id="@+id/widget_info_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_info_pill"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:fontFamily="serif"
                android:id="@+id/widget_standing_h2h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Little Caesars Arena &#8226; Home &#8226; 4 pts out"
                android:textColor="#1A1210"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_venue_info"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center vertical separator -->
    <FrameLayout
        android:id="@+id/widget_center_separator"
        android:layout_width="1.5dp"
        android:layout_height="match_parent"
        android:background="#DDD6C7"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp" />

    <!-- RIGHT PANE: Standings Table (52% width) -->
    <LinearLayout
        android:id="@+id/widget_right_pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.08"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="4dp">

        <LinearLayout
            android:id="@+id/widget_standings_table"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_standings_bg"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="2dp">

            <!-- Column 1 (Ranks 1, 3, 5, 7) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:fontFamily="serif"
                    android:id="@+id/widget_team_1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="1. BOS: 51-20-11"
                    android:textColor="#1A1210"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDD6C7" />

                <TextView
                    android:fontFamily="serif"
                    android:id="@+id/widget_team_3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="3. FLA: 45-27-10"
                    android:textColor="#1A1210"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDD6C7" />

                <TextView
                    android:fontFamily="serif"
                    android:id="@+id/widget_team_5"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="5. TBL: 40-32-10"
                    android:textColor="#1A1210"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDD6C7" />

                <TextView
                    android:fontFamily="serif"
                    android:id="@+id/widget_team_7"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="7. OTT: 34-39-9"
                    android:textColor="#1A1210"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Column Divider -->
            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#DDD6C7" />

            <!-- Column 2 (Ranks 2, 4, 6, 8) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:fontFamily="serif"
                    android:id="@+id/widget_team_2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="2. TOR: 46-26-10"
                    android:textColor="#1A1210"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDD6C7" />

                <TextView
                    android:fontFamily="serif"
                    android:id="@+id/widget_team_4"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="4. DET: 42-30-10"
                    android:textColor="#CE1126"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDD6C7" />

                <TextView
                    android:fontFamily="serif"
                    android:id="@+id/widget_team_6"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="6. MTL: 37-36-9"
                    android:textColor="#1A1210"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDD6C7" />

                <TextView
                    android:fontFamily="serif"
                    android:id="@+id/widget_team_8"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="8. BUF: 30-43-9"
                    android:textColor="#1A1210"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
