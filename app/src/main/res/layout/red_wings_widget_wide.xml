<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_home"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clipToPadding="true"
    android:clipChildren="true"
    android:padding="0dp">

    <!-- LEFT PANE: Matchup & Countdown Hub (48% width) -->
    <LinearLayout
        android:id="@+id/widget_left_pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="4dp">

        <!-- Header: Ribbon -->
        <LinearLayout
            android:id="@+id/widget_header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_header_ribbon"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/widget_header_logo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_redwings_logo"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_title"
                android:fontFamily="sans-serif-black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RED WINGS"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Button
                android:id="@+id/widget_theme_toggle"
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_tag_home"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="🔴 HOME"
                android:textColor="#FFFFFF"
                android:textSize="7.5sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_divider_top"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFFFFF"
            android:visibility="gone" />

        <!-- Matchup row: frosted hero card -->
        <LinearLayout
            android:id="@+id/widget_matchup_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_matchup_frosted_bg"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="4dp">

            <!-- Away Team (Left) -->
            <LinearLayout
                android:id="@+id/widget_away_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical|start">

                <ImageView
                    android:id="@+id/widget_away_logo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_puck_vector" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_away_tag"
                        android:fontFamily="sans-serif-bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AWAY"
                        android:textColor="#64748B"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_away_name"
                        android:fontFamily="sans-serif-black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOR"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_away_record"
                        android:fontFamily="sans-serif-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20-8-6"
                        android:textColor="#475569"
                        android:textSize="8sp"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Center Game Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_matchup_badge"
                    android:fontFamily="sans-serif-bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/widget_at_puck_badge"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_marginBottom="1dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_opponent"
                    android:fontFamily="sans-serif-black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAT • 7:00 PM"
                    android:textColor="#0F172A"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_countdown"
                    android:fontFamily="sans-serif-black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02 : 14 : 22"
                    android:textColor="#C8102E"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Home Team (Right) -->
            <LinearLayout
                android:id="@+id/widget_home_layout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical|end">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/widget_home_tag"
                        android:fontFamily="sans-serif-bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOME"
                        android:textColor="#C8102E"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_home_name"
                        android:fontFamily="sans-serif-black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DET"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_home_record"
                        android:fontFamily="sans-serif-medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22-7-5"
                        android:textColor="#475569"
                        android:textSize="8sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_home_logo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_redwings_logo" />
            </LinearLayout>
        </LinearLayout>

        <!-- Venue Pill -->
        <LinearLayout
            android:id="@+id/widget_info_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/widget_venue_pill"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/widget_standing_h2h"
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Little Caesars Arena"
                android:textColor="#1E293B"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_venue_info"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- RIGHT PANE: Standings Matrix (52% width) -->
    <LinearLayout
        android:id="@+id/widget_standings_table"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.08"
        android:background="@drawable/widget_standings_frosted_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="4dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Column 1 (Playoff Seeds 1-4) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_seeds_header"
                android:fontFamily="sans-serif-bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEEDS (1-4)"
                android:textColor="#1E293B"
                android:textSize="7sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="3dp"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_team_1"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 BOS"
                    android:textColor="#334155"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_team_2"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 FLA"
                    android:textColor="#334155"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_team_3"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 TOR"
                    android:textColor="#334155"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_team_4"
                    android:fontFamily="sans-serif-black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 DET"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_det_highlight_pill"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider line between columns -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp" />

        <!-- Column 2 (In the Hunt 5-8) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_hunt_header"
                android:fontFamily="sans-serif-bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HUNT (5-8)"
                android:textColor="#1E293B"
                android:textSize="7sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="3dp"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_team_5"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 TBL"
                    android:textColor="#334155"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_team_6"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6 OTT"
                    android:textColor="#334155"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_team_7"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7 BUF"
                    android:textColor="#334155"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_team_8"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 MTL"
                    android:textColor="#334155"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
