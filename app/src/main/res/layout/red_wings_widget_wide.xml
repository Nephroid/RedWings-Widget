<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_home"
    android:orientation="vertical"
    android:gravity="fill"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <!-- REGION 1: Home Red Sweater Ribbon Header (Full Width) -->
    <LinearLayout
        android:id="@+id/widget_header_layout"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/widget_header_ribbon"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp">

        <!-- Left White Racing Stripes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#FFFFFF" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="2dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#FFFFFF" />
        </LinearLayout>

        <!-- Winged Wheel Crest in Header -->
        <ImageView
            android:id="@+id/widget_header_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_redwings_logo"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <!-- Bold Detroit Red Wings Wordmark -->
        <TextView
            android:id="@+id/widget_title"
            android:fontFamily="sans-serif-black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETROIT RED WINGS"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:includeFontPadding="false" />

        <!-- Right White Racing Stripes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:gravity="center">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#FFFFFF" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="2dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#FFFFFF" />
        </LinearLayout>

        <!-- Invisible ID preservation elements -->
        <TextView
            android:id="@+id/widget_tag"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/widget_theme_toggle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Top Divider Line -->
    <FrameLayout
        android:id="@+id/widget_divider_top"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#FFFFFF" />

    <!-- DUAL-PANE BODY: Left = Matchup Hero Card; Right = Standings Matrix Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- LEFT PANE: Matchup Card with Floating Badge & Venue Pill -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <!-- Matchup Hero Card -->
            <LinearLayout
                android:id="@+id/widget_matchup_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_standings_frosted_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="22dp">

                <!-- Away Team (Left) -->
                <LinearLayout
                    android:id="@+id/widget_away_layout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical|start">

                    <ImageView
                        android:id="@+id/widget_away_logo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_puck_vector" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_away_tag"
                            android:fontFamily="sans-serif-bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AWAY"
                            android:textColor="#64748B"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/widget_away_name"
                            android:fontFamily="sans-serif-black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#0F172A"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/widget_away_record"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#475569"
                            android:textSize="10.5sp"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Center: Game Date/Time + Crimson Countdown Numerals -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/widget_opponent"
                        android:fontFamily="sans-serif-black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginBottom="2dp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_countdown"
                        android:fontFamily="sans-serif-black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- : --"
                        android:textColor="#C8102E"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        android:gravity="center"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Home Team (Right) -->
                <LinearLayout
                    android:id="@+id/widget_home_layout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical|end">

                    <ImageView
                        android:id="@+id/widget_home_logo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_redwings_logo" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_home_tag"
                            android:fontFamily="sans-serif-bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HOME"
                            android:textColor="#64748B"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/widget_home_name"
                            android:fontFamily="sans-serif-black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DET"
                            android:textColor="#0F172A"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/widget_home_record"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#475569"
                            android:textSize="10.5sp"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Floating Clash Puck Badge centered on the header seam -->
            <TextView
                android:id="@+id/widget_matchup_badge"
                android:fontFamily="sans-serif-black"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-11dp"
                android:elevation="8dp"
                android:text="@"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/widget_at_puck_badge"
                android:includeFontPadding="false" />

            <!-- Venue Pill at bottom of Matchup card -->
            <LinearLayout
                android:id="@+id/widget_info_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:elevation="6dp"
                android:background="@drawable/widget_venue_pill"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_standing_h2h"
                    android:fontFamily="sans-serif-bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Little Caesars Arena"
                    android:textColor="#1E293B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_venue_info"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- RIGHT PANE: Atlantic Standings Matrix Card -->
        <LinearLayout
            android:id="@+id/widget_standings_table"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_standings_frosted_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Section 1: Playoff Seeds (1-4) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_seeds_header"
                    android:fontFamily="sans-serif-bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAYOFF SEEDS (1-4)"
                    android:textColor="#1E293B"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"
                    android:includeFontPadding="false" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0.75dp"
                    android:background="#CBD5E1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/widget_team_1"
                        android:fontFamily="sans-serif-bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 --"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="14dp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_team_2"
                        android:fontFamily="sans-serif-bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 --"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="14dp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_team_3"
                        android:fontFamily="sans-serif-bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 --"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="14dp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_team_4"
                        android:fontFamily="sans-serif-bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 --"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="14dp"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hairline Divider between Seeds and Hunt -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0.75dp"
                android:background="#CBD5E1"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Section 2: In The Hunt (5-8) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_hunt_header"
                    android:fontFamily="sans-serif-bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IN THE HUNT (5-8)"
                    android:textColor="#1E293B"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"
                    android:includeFontPadding="false" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0.75dp"
                    android:background="#CBD5E1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/widget_team_5"
                        android:fontFamily="sans-serif-bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 --"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="14dp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_team_6"
                        android:fontFamily="sans-serif-bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 --"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="14dp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_team_7"
                        android:fontFamily="sans-serif-bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 --"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="14dp"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_team_8"
                        android:fontFamily="sans-serif-bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8 --"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
