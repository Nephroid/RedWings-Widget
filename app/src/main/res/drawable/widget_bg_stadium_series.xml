<?xml version="1.0" encoding="utf-8"?>
<!-- Stadium Series Special Jersey: modern brushed slate with silver and stadium red border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#1A1D24" />
            <stroke android:width="1.5dp" android:color="#A2AAAD" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#FF2D20" />
        </shape>
    </item>
</layer-list>
