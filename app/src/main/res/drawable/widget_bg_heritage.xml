<?xml version="1.0" encoding="utf-8"?>
<!-- Heritage 1926 frame: paper cream, ink outer rule, red inner keyline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#1A1210" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#F5F1E6" />
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#CE1126" />
        </shape>
    </item>
</layer-list>
