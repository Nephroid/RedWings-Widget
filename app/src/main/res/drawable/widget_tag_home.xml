<?xml version="1.0" encoding="utf-8"?>
<!-- Home Team Vibrant Crimson Glass Pill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:startColor="#B3FF6B7B"
                android:centerColor="#33CE1126"
                android:endColor="#66CE1126"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#E6C8102E" />
        </shape>
    </item>
</layer-list>
