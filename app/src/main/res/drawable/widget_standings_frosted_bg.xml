<?xml version="1.0" encoding="utf-8"?>
<!-- Universal Concentric Standings Frosted Card (12dp radius) with Top Specular Rim -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="135"
                android:centerColor="#10FFFFFF"
                android:endColor="#1FFFFFFF"
                android:startColor="#47FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <gradient
                android:angle="270"
                android:endColor="#12FFFFFF"
                android:startColor="#24FFFFFF"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
