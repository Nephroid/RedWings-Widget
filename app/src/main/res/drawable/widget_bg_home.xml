<?xml version="1.0" encoding="utf-8"?>
<!-- Home Red Anodized Glass Substrate: 4-layer optical stack with 135° specular rim lighting -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAYER 0: Ambient Occlusion Keyline -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>

    <!-- LAYER 1: 135° Specular Rim Lighting -->
    <item
        android:bottom="0.5dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="23.5dp" />
            <gradient
                android:angle="135"
                android:centerColor="#26FFFFFF"
                android:endColor="#40FF6B7B"
                android:startColor="#80FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- LAYER 2: Anodized Hockey Red Glass Volume -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="22.5dp" />
            <gradient
                android:angle="315"
                android:centerColor="#E6A30C1D"
                android:endColor="#F25E030D"
                android:startColor="#E6C81429"
                android:type="linear" />
        </shape>
    </item>

    <!-- LAYER 3: Caustic Surface Sheen -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="22.5dp" />
            <gradient
                android:centerX="0.15"
                android:centerY="0.10"
                android:endColor="#00FFFFFF"
                android:gradientRadius="260dp"
                android:startColor="#26FFFFFF"
                android:type="radial" />
        </shape>
    </item>

</layer-list>
