<?xml version="1.0" encoding="utf-8"?>
<!-- Home Red Sweater / Frosted Ice substrate: icy translucent base with specular glass border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#DFEAF2"
        android:centerColor="#D4E4EE"
        android:endColor="#CADEE9" />
    <stroke android:width="2dp" android:color="#FFFFFF" />
</shape>
