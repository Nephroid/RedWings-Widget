<?xml version="1.0" encoding="utf-8"?>
<!-- Away Team Glass Pill (Ice white translucent with crisp outline) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:startColor="#80FFFFFF"
                android:centerColor="#26FFFFFF"
                android:endColor="#40FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
