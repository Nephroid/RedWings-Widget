<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAYER 0: Outer Ambient Occlusion Keyline (prevents washout on white wallpapers) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#26000000" />
        </shape>
    </item>

    <!-- LAYER 1: 135° Specular Rim Lighting (Beveled Glass Edge) -->
    <item
        android:bottom="0.5dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="23.5dp" />
            <gradient
                android:angle="135"
                android:centerColor="#14FFFFFF"
                android:endColor="#38A5F3FC"
                android:startColor="#73FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- LAYER 2: Primary Frosted Ice Refractive Volume (High-Density OLED Slate/Ice) -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="22.5dp" />
            <gradient
                android:angle="315"
                android:centerColor="#E60F172A"
                android:endColor="#F0090D16"
                android:startColor="#D91E293B"
                android:type="linear" />
        </shape>
    </item>

    <!-- LAYER 3: Ambient Top-Left Caustic Surface Refraction -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="22.5dp" />
            <gradient
                android:centerX="0.15"
                android:centerY="0.10"
                android:endColor="#00FFFFFF"
                android:gradientRadius="260dp"
                android:startColor="#1FFFFFFF"
                android:type="radial" />
        </shape>
    </item>

</layer-list>
