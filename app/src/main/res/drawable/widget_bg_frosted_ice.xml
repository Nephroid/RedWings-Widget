<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted Ice & Home Red Sweater substrate: icy translucent base with specular glass border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#D6E4EE"
        android:centerColor="#C8DBE7"
        android:endColor="#BACFE0" />
    <stroke android:width="2dp" android:color="#FFFFFF" />
</shape>

