<?xml version="1.0" encoding="utf-8"?>
<!-- Apple-Grade Anodized Crimson Glass Highlight Pill for DET Standings Row -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Specular Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="135"
                android:centerColor="#33CE1126"
                android:endColor="#66CE1126"
                android:startColor="#B3FF6B7B"
                android:type="linear" />
        </shape>
    </item>

    <!-- Anodized Crimson Translucent Glass -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <gradient
                android:angle="0"
                android:centerColor="#E6C8102E"
                android:endColor="#E6A30C1D"
                android:startColor="#E6D61535"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
